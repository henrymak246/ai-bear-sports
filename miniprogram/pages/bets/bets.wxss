/* bets.wxss — 我的投注页样式(通用卡片/徽章/判定/空态在 app.wxss) */

/* 统计卡 */
.stat-card { border-top: 6rpx solid #F5A623; }
.stat-row { display: flex; justify-content: space-between; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 800; color: #8B5A2B; }
.stat-label { font-size: 22rpx; color: #A8A29E; margin-top: 4rpx; }
.stat-sub { margin-top: 14rpx; text-align: center; font-size: 22rpx; }

.pos { color: #2F9E63; }
.neg { color: #F25C5C; }

/* 刷新按钮 */
.refresh-row {
  margin: 4rpx 20rpx 0;
  display: flex;
  justify-content: flex-end;
}
.refresh-btn {
  background: #8B5A2B;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 6rpx 30rpx;
  line-height: 1.7;
}
.refresh-btn[disabled] { opacity: 0.5; }
.refresh-btn::after { border: none; }

/* 注单卡 */
.bet-head { display: flex; align-items: center; gap: 12rpx; }
.bet-date { font-size: 22rpx; }
.cap {
  margin-left: auto;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
}
.cap-pending { background: #F5A623; } /* 黄 */
.cap-hit { background: #2F9E63; }     /* 绿 */
.cap-miss { background: #F25C5C; }    /* 红 */
.cap-half { background: #5B8DEF; }    /* 蓝 */

/* 腿明细 */
.leg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}
.leg-main { flex: 1; min-width: 0; }
.leg-match { font-size: 26rpx; font-weight: 700; color: #4A3A28; }
.leg-score { color: #D97706; font-weight: 800; }
.leg-pick { font-size: 22rpx; margin-top: 2rpx; }
.judge-half { background: #5B8DEF; } /* ◐ 半红蓝 */

/* 底部金额行 */
.bet-foot {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #F0E2CC;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap; /* 窄屏放不下时按钮组整体落下一行(右侧对齐), 不挤坏金额文字 */
  gap: 10rpx;
  font-size: 24rpx;
}
.profit { font-weight: 700; }
.bet-note { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; }

/* 投注图按钮 */
.slip-btn {
  color: #8B5A2B;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #D9C7AE;
  border-radius: 8rpx;
}

/* 腿行「✎ 改选项」入口(北单/竞彩胜平负/竞彩让球腿才有, 亚盘腿不出) */
.leg-edit {
  flex: none;
  color: #8B5A2B;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 4rpx 16rpx;
  border: 1rpx solid #D9C7AE;
  border-radius: 8rpx;
}

/* 底部按钮组(投注图 + 删除): 包成单个 child, 不挤坏 .bet-foot 的 space-between */
.bet-actions {
  flex: none;
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.del-btn {
  color: #F25C5C;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #F5C0C0;
  border-radius: 8rpx;
}

/* ---- 编辑选项抽屉 ----
   遮罩/抽屉样式在项目里是**页面级**的(见 index.wxss 的 .cart-mask/.cart-drawer),
   app.wxss 没有对应工具类 → 这里自带一份, 别指望全局。 */
.edit-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 60;
}
.edit-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 61;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head { display: flex; align-items: center; gap: 12rpx; }
.sheet-title { flex: 1; font-size: 30rpx; font-weight: 800; color: #4A3A28; }
.sheet-close { flex: none; color: #A8A29E; font-size: 32rpx; padding: 0 12rpx; }
.sheet-sub { font-size: 22rpx; margin-top: 6rpx; }

.opt-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #E7E1DA;
  border-radius: 12rpx;
}
.opt-box { flex: none; width: 36rpx; text-align: center; font-size: 28rpx; color: #C4BDB4; }
.opt-on { color: #2F9E63; }
.opt-label { flex: none; font-size: 28rpx; font-weight: 700; color: #4A3A28; }
.opt-code { font-size: 22rpx; }
.opt-odds { margin-left: auto; font-size: 24rpx; color: #8B5A2B; }
/* 无赔率选项: 置灰不可选(靠后声明覆盖上面的颜色, 不用 !important) */
.opt-off { color: #C4BDB4; }

.sheet-preview {
  margin-top: 18rpx;
  padding: 12rpx 20rpx;
  background: #FBF6EF;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #8B5A2B;
  line-height: 1.6;
}
.sheet-foot { display: flex; gap: 20rpx; margin-top: 22rpx; }
.btn-cancel, .btn-save {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  line-height: 2.2;
}
.btn-cancel { background: #F5F1EA; color: #8B5A2B; }
.btn-save { background: #F5A623; color: #FFFFFF; }
.btn-cancel[disabled], .btn-save[disabled] { opacity: 0.5; }
.btn-cancel::after, .btn-save::after { border: none; }
/* 投注参考图屏外画布 */
.slip-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
}
