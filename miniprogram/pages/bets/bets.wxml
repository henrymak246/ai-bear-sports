<view class="err-banner" wx:if="{{errMsg}}">{{errMsg}}</view>

<!-- 统计卡 -->
<view class="card stat-card" wx:if="{{stats}}">
  <view class="stat-row">
    <view class="stat-item">
      <view class="stat-num">{{stats.totalAmount}}</view>
      <view class="stat-label">总投入(元)</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.totalPayout}}</view>
      <view class="stat-label">总回收(元)</view>
    </view>
    <view class="stat-item">
      <view class="stat-num {{stats.profit > 0 ? 'pos' : stats.profit < 0 ? 'neg' : ''}}">{{stats.profit}}</view>
      <view class="stat-label">净盈亏(元)</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.hitRate === null ? '--' : stats.hitRate + '%'}}</view>
      <view class="stat-label">命中率</view>
    </view>
  </view>
  <view class="stat-sub muted">共 {{stats.count}} 注单 · 已结算 {{stats.settled}} · 待结算 {{stats.pending}}</view>
</view>

<!-- 刷新比分 -->
<view class="refresh-row" wx:if="{{bets.length}}">
  <button class="refresh-btn" bindtap="refreshScores" disabled="{{settling}}">{{settling ? '结算中…' : '↻ 刷新比分'}}</button>
</view>

<view class="loading" wx:if="{{loading}}">加载中…</view>

<!-- 注单列表 -->
<view class="card bet-card" wx:for="{{bets}}" wx:key="id">
  <view class="bet-head">
    <text class="bet-date muted">{{item.bet_date}}</text>
    <text class="badge {{item.srcCls}}">{{item.srcLabel}}</text>
    <text class="cap {{item.capCls}}">{{item.capText}}</text>
  </view>
  <!-- wx:for-index 必须显式声明: 否则内层 index 会遮蔽外层(下面 data-id 用的是外层 item.id) -->
  <view class="leg-row" wx:for="{{item.legRows}}" wx:for-item="leg" wx:for-index="legIndex" wx:key="index">
    <text class="judge {{leg.markCls}}">{{leg.mark}}</text>
    <view class="leg-main">
      <view class="leg-match">
        {{leg.matchText}}<text class="leg-score" wx:if="{{leg.finalScore}}"> {{leg.finalScore}}</text>
      </view>
      <view class="leg-pick muted">{{leg.bdNumText}}{{leg.bdNumText ? ' · ' : ''}}{{leg.pickText}} @ {{leg.oddsText}}</view>
    </view>
    <text class="leg-edit" wx:if="{{leg.canEdit}}" data-id="{{item.id}}" data-li="{{legIndex}}" catchtap="openEdit">✎</text>
  </view>
  <view class="bet-foot">
    <text class="muted">{{item.stakes}}注 · 投入 {{item.amountText}}</text>
    <text wx:if="{{item.status !== 'pending'}}" class="profit {{item.profitCls}}">回收 {{item.payoutText}} · {{item.profitText}}</text>
    <text wx:else class="muted">预期 {{item.expectText || '--'}}</text>
    <!-- 两个按钮包成单个 child: 原来 3 个 child 的 space-between 直接塞第 4 个, 窄屏会挤 -->
    <view class="bet-actions">
      <text class="slip-btn" data-id="{{item.id}}" catchtap="previewSlip">🖼 投注图</text>
      <text class="del-btn" data-id="{{item.id}}" catchtap="removeBet">🗑 删除</text>
    </view>
  </view>
  <view class="bet-note muted" wx:if="{{item.note}}">{{item.note}}</view>
</view>

<view class="empty" wx:if="{{!loading && !errMsg && !bets.length}}">还没有登记, 去推荐页组一串🐾</view>

<!-- 投注参考图屏外画布(出图用, 不可见) -->
<canvas type="2d" id="slipCanvas" class="slip-canvas" style="width:750px;height:{{slipCanvasH}}px" />

<!-- 编辑腿的 310 选项: 底部抽屉(遮罩/抽屉是页面级样式, 这里自带一份) -->
<view class="edit-mask" wx:if="{{editOpen}}" bindtap="closeEdit"></view>
<view class="edit-sheet" wx:if="{{editOpen}}">
  <view class="sheet-head">
    <text class="sheet-title">{{editTitle}}</text>
    <text class="sheet-close" bindtap="closeEdit">✕</text>
  </view>
  <view class="sheet-sub muted">改这一腿的 310 选项(可多选复式), 注数与投入自动重算</view>
  <view class="opt-row" wx:for="{{editOpts}}" wx:key="code" data-code="{{item.code}}" bindtap="toggleOpt">
    <text class="opt-box {{item.on ? 'opt-on' : ''}} {{item.disabled ? 'opt-off' : ''}}">{{item.on ? '✓' : '○'}}</text>
    <text class="opt-label {{item.disabled ? 'opt-off' : ''}}">{{item.label}}</text>
    <text class="opt-code muted">{{item.code}}</text>
    <text class="opt-odds {{item.disabled ? 'opt-off' : ''}}">{{item.odds ? '@ ' + item.odds : '无赔率'}}</text>
  </view>
  <view class="sheet-preview">{{editPreview}}</view>
  <view class="sheet-foot">
    <button class="btn-cancel" bindtap="closeEdit" disabled="{{editSaving}}">取消</button>
    <button class="btn-save" bindtap="saveEdit" disabled="{{editSaving}}">{{editSaving ? '保存中…' : '保存'}}</button>
  </view>
</view>
