<view class="page">
  <!-- 顶栏: 日期 + 发布标题 + 三 Tab -->
  <view class="topbar card">
    <view class="topbar-row">
      <text class="topbar-date">📅 {{payload.date || '--'}}</text>
      <text class="muted topbar-updated" wx:if="{{lastUpdated}}">更新 {{lastUpdated}}</text>
      <text class="muted topbar-updated" wx:if="{{scoreStatus}}"> · {{scoreStatus}}</text>
      <text class="odds-badge {{oddsStatus === '官方实时' ? 'odds-live' : 'odds-snap'}}" wx:if="{{oddsStatus}}">赔率{{oddsStatus}}</text>
    </view>
    <view class="daily-title" wx:if="{{dailyTitle}}">{{dailyTitle}}</view>
    <view class="tabs">
      <view class="tab {{tab === 'jc' ? 'tab-on' : ''}}" data-tab="jc" bindtap="switchTab">🎫 竞彩</view>
      <view class="tab {{tab === 'bd' ? 'tab-on' : ''}} {{bdDisabled ? 'tab-off' : ''}}" data-tab="bd" bindtap="switchTab">🀄 北单</view>
      <view class="tab {{tab === 'ah' ? 'tab-on' : ''}}" data-tab="ah" bindtap="switchTab">🌏 亚盘</view>
    </view>
  </view>

  <view class="err-banner" wx:if="{{errMsg}}">⚠️ {{errMsg}}</view>
  <view class="stale-banner" wx:if="{{staleTip}}">🕐 {{staleTip}}</view>
  <view class="loading" wx:if="{{loading && !payload}}">小熊搬运中…</view>

  <!-- ============ 🎫 竞彩 Tab ============ -->
  <block wx:if="{{tab === 'jc' && payload}}">
    <!-- 竞彩赔率已实时化(utils/jc.js)时的口径说明: 大号倍数已按实时值同步,
         但正文括号里的赔率(如 "010让-1主胜(2.20")写于构建时, 是模型当时的推理记录 ——
         逐条改写会把推理文句改花, 所以在这里统一说明, 并指向下方场次卡的实时价 -->
    <view class="card plan-note-card" wx:if="{{oddsStatus === '官方实时'}}">
      <view class="plan-text">🔴 竞彩赔率已接官方实时: 方案大号倍数为实时连乘值; 正文括号内的赔率是构建时推理记录, 实时价以场次卡为准。</view>
    </view>
    <view class="card plan-card" wx:for="{{planJc}}" wx:key="name">
      <view class="plan-head">
        <text class="plan-name">{{item.name}}</text>
        <text class="plan-pct" wx:if="{{item.pct}}">{{item.pct}}</text>
      </view>
      <view class="plan-text">{{item.text}}</view>
      <!-- 正文里把让球-only 的场当胜平负写了 → 挂一句口径说明(见 utils/jc.js noHadNote); 正文一个字不动 -->
      <view class="plan-nohad" wx:if="{{item.noHadNote}}">{{item.noHadNote}}</view>
    </view>

    <view class="card match-card {{item.oddsClosed ? 'm-closed' : ''}}" wx:for="{{groups.jc}}" wx:key="id">
      <view class="m-head">
        <view class="m-teams">
          <text class="m-league muted">{{item.league}} · {{item.id}}</text>
          <view class="m-vs">{{item.home}} <text class="muted">vs</text> {{item.away}}</view>
        </view>
        <view class="m-score">
          <text wx:if="{{item.liveSt === 'MANUAL'}}" class="live-score score-manual">(人工) {{item.liveScore}}</text>
          <text wx:elif="{{item.liveSt === 'STATUS_FULL_TIME' || item.liveSt === 'STATUS_FINAL_AET' || item.liveSt === 'STATUS_FINAL_PEN'}}" class="live-score score-ft">完场 {{item.liveScore}}</text>
          <text wx:elif="{{item.liveSt && item.liveSt !== 'STATUS_SCHEDULED' && item.liveScore}}" class="live-score score-live">⚽ {{item.liveScore}}</text>
          <text wx:else class="live-score">{{item.time}}</text>
        </view>
      </view>
      <view class="m-line">
        <text class="badge {{item.badgeClass}}">{{item.dirTag || '方向'}}</text>
        <text class="m-dir">{{item.direction}}</text>
        <text class="star" wx:if="{{item.stars}}">{{item.stars}}</text>
      </view>
      <!-- 两个盘各一行(2026-09-15 用户拍板, 照体彩计算器): 「胜负」盘 / 「让球胜负(盘口)」盘 ——
           原来挤成一行靠 SP / 让球SP 前缀分隔, 看不出哪个数属于哪个盘、也说不清哪个盘没开。
           官方只开让球、没开胜平负的场(让球-only, 见 utils/jc.js noHadOf): spLine 为空, 只显让球那行 -->
      <view class="m-line muted" wx:if="{{item.spLine || item.hhadLine}}">
        <text class="mkt-row {{item.spBlank ? 'od-nohad' : ''}}" wx:if="{{item.spLine}}">{{item.spLine}}</text>
        <text class="mkt-row" wx:if="{{item.hhadLine}}">{{item.hhadLine}}</text>
      </view>
      <!-- 独立成行: SP 两个都空的场也必须看得见"已停售" -->
      <view class="m-line" wx:if="{{item.oddsTip}}">
        <text class="{{item.oddsClosed ? 'closed-tag' : 'live-tag'}}">{{item.oddsTip}}</text>
      </view>
      <view class="m-line muted">
        <text wx:if="{{item.overUnder}}">总进球 {{item.overUnder}}<text wx:if="{{item.ttgSp}}"> @{{item.ttgSp}}</text></text>
        <text wx:if="{{item.scoreText}}">比分 {{item.scoreText}}</text>
      </view>
      <view class="m-note-toggle" wx:if="{{item.note}}" data-id="{{item.id}}" bindtap="toggleNote">
        ℹ️ {{noteMap[item.id] ? '收起备注' : '备注'}}
      </view>
      <view class="m-note" wx:if="{{item.note && noteMap[item.id]}}">{{item.note}}</view>
      <!-- 组串勾选(勾选态显示; ⇄ 切换胜平负/让球两种腿) -->
      <view class="m-cart" wx:if="{{cartMode}}">
        <checkbox class="m-check" checked="{{!!cartSel['jc:' + item.id]}}" data-key="jc:{{item.id}}" data-type="jc" data-id="{{item.id}}" bindtap="toggleCart" />
        <!-- 让球-only 场没有胜平负腿可换: 不给 ⇄ 开关, 直接写明腿型(index.js 的 makeLeg 也拦着) -->
        <text class="m-swap m-swap-fix" wx:if="{{item.noHad}}">仅让球盘</text>
        <text class="m-swap" wx:else data-id="{{item.id}}" catchtap="switchJcKind">⇄ {{jcKindMap[item.id] === 'hhad' ? '让球' : '胜平负'}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!groups.jc.length}}">等小熊补充🐾</view>
  </block>

  <!-- ============ 🀄 北单 Tab ============ -->
  <block wx:if="{{tab === 'bd' && payload}}">
    <view class="card plan-note-card" wx:if="{{bdNote}}">
      <view class="plan-text">{{bdNote}}</view>
    </view>
    <view class="card plan-card" wx:for="{{planBd}}" wx:key="name">
      <view class="plan-head">
        <text class="plan-name">{{item.name}}</text>
        <text class="plan-pct" wx:if="{{item.pct}}">{{item.pct}}</text>
      </view>
      <view class="plan-text">{{item.text}}</view>
    </view>

    <!-- 三时段北单票: 新结构逐腿对象, 旧数据无 slot8 时整块不渲染 -->
    <view class="card slot8-card" wx:for="{{slot8Bd}}" wx:for-item="slot" wx:key="key">
      <view class="slot8-head">
        <text class="slot8-title">{{slot.label}}北单票 · {{slot.time}}</text>
        <text class="slot8-cost">{{slot.beidan.stakes}}注 · {{slot.beidan.cost}}元</text>
      </view>
      <view class="slot8-meta muted" wx:if="{{slot.beidan.issue}}">期号 {{slot.beidan.issue}} · 共{{slot.beidan.legs.length}}腿</view>
      <view class="slot8-leg" wx:for="{{slot.beidan.legs}}" wx:for-item="leg" wx:key="bdNum">
        <view class="slot8-match">{{leg.bdNum}} {{leg.match}}</view>
        <view class="slot8-line">
          <text class="slot8-pick">{{leg.pick}}</text>
          <text class="slot8-handicap">让{{leg.handicap}}</text>
          <text class="slot8-odds">SP {{leg.sp3Text}}</text>
        </view>
      </view>
    </view>

    <view class="card leg-card" wx:for="{{groups.bd}}" wx:key="bdNum">
      <view class="m-head">
        <view class="m-teams">
          <text class="m-league muted">北单{{item.bdNum}}</text>
          <view class="m-vs">{{item.home}} <text class="muted">vs</text> {{item.away}}</view>
        </view>
        <text class="judge {{item.judgeClass}}">{{item.judgeLabel}}</text>
      </view>
      <view class="m-line">
        <text class="badge badge-gold">让{{item.handicap}}</text>
        <text class="m-dir">推荐 {{item.pick}}</text>
        <text class="muted" wx:if="{{item.finalScore}}">赛果 {{item.finalScore}}</text>
      </view>
      <view class="sp3" wx:if="{{item.sp3.length}}">
        <view class="sp3-cell"><view class="muted sp3-label">胜</view>{{item.sp3[0] || '-'}}</view>
        <view class="sp3-cell"><view class="muted sp3-label">平</view>{{item.sp3[1] || '-'}}</view>
        <view class="sp3-cell"><view class="muted sp3-label">负</view>{{item.sp3[2] || '-'}}</view>
      </view>
      <view class="m-note" wx:if="{{item.reason}}">{{item.reason}}</view>
      <!-- 组串勾选: 北单腿整腿可勾 -->
      <view class="m-cart" wx:if="{{cartMode}}">
        <checkbox class="m-check" checked="{{!!cartSel['bd:' + item.bdNum]}}" data-key="bd:{{item.bdNum}}" data-type="bd" data-bdnum="{{item.bdNum}}" bindtap="toggleCart" />
      </view>
    </view>
    <view class="empty" wx:if="{{!groups.bd.length}}">等小熊补充🐾</view>
  </block>

  <!-- ============ 🌏 亚盘 Tab ============ -->
  <block wx:if="{{tab === 'ah' && payload}}">
    <!-- 三时段让球/大小混编票; 下方原有 asian7 与单场观点保持不变 -->
    <view class="card slot8-card" wx:for="{{slot8Ah}}" wx:for-item="slot" wx:key="key">
      <view class="slot8-head">
        <text class="slot8-title">{{slot.label}}混编票 · {{slot.time}}</text>
        <text class="slot8-cost">{{slot.asian.cost}}元</text>
      </view>
      <view class="slot8-meta muted">让球/大小 · 共{{slot.asian.legs.length}}腿<text wx:if="{{slot.asian.totalOdds}}"> · {{slot.asian.totalOdds}}</text></view>
      <view class="slot8-leg" wx:for="{{slot.asian.legs}}" wx:for-item="leg" wx:key="index">
        <view class="slot8-match">{{leg.id}} {{leg.match}}</view>
        <view class="slot8-line">
          <text class="slot8-play">{{leg.play}}</text>
          <text class="slot8-pick">{{leg.pick}}</text>
          <text class="slot8-handicap" wx:if="{{leg.handicap}}">盘 {{leg.handicap}}</text>
          <text class="slot8-odds">@{{leg.oddsText}}</text>
        </view>
      </view>
    </view>

    <!-- 🌏 亚盘推荐串(asian7 七腿, 来自网站同源数据) -->
    <view class="card a7-card" wx:if="{{asian7View}}">
      <view class="a7-head"><text class="a7-title">🌏 今日亚盘推荐串(asian7)</text></view>
      <view class="a7-leg" wx:for="{{asian7View.legs}}" wx:key="index">
        <text class="a7-pick">{{item.pick}}</text>
        <text class="a7-match muted">{{item.match}}</text>
        <text class="a7-odds">@{{item.odds}}</text>
      </view>
      <view class="a7-note muted" wx:if="{{asian7View.note}}">{{asian7View.note}}</view>
    </view>
    <view class="empty" wx:if="{{!slot8Ah.length && !asian7View}}">今日暂无亚盘推荐串🐾</view>
    <view class="card match-card" wx:for="{{groups.ah}}" wx:key="id">
      <view class="m-head">
        <view class="m-teams">
          <text class="m-league muted">{{item.league}} · {{item.id}}</text>
          <view class="m-vs">{{item.home}} <text class="muted">vs</text> {{item.away}}</view>
        </view>
        <text class="live-score">{{item.time}}</text>
      </view>
      <view class="m-line">
        <text class="m-dir">让球 {{item.ahPick}}</text>
        <text class="star" wx:if="{{item.ahStars}}">{{item.ahStars}}</text>
      </view>
      <view class="m-line" wx:if="{{item.ouPick}}">
        <text class="m-dir">大小 {{item.ouPick}}</text>
        <text class="star" wx:if="{{item.ouStars}}">{{item.ouStars}}</text>
      </view>
      <view class="m-line muted" wx:if="{{item.ahName}}">盘口 {{item.ahName}} ｜ 主水 {{item.ahHome}} ／ 客水 {{item.ahAway}}</view>
      <view class="m-line ahmv" wx:if="{{item.ahMoves}}">📈 盘路 {{item.ahMoves}}</view>
      <view class="m-line ahmv" wx:if="{{item.ahMoveAdvice}}" style="color:#1F7A4D">🎯 建议 {{item.ahMoveAdvice}}</view>
      <view class="m-line muted" wx:if="{{item.ouName}}">大小 {{item.ouName}} ｜ 大水 {{item.ouOver}} ／ 小水 {{item.ouUnder}}</view>
      <!-- 组串勾选: 让球腿/大小球腿各自独立勾选, ⇄ 切换选项后自由组合 -->
      <view class="m-cart" wx:if="{{cartMode}}">
        <view class="m-cart-row">
          <checkbox class="m-check" checked="{{!!cartSel['ah:' + item.id]}}" data-key="ah:{{item.id}}" data-type="ah" data-id="{{item.id}}" bindtap="toggleCart" />
          <text class="m-cart-label">让球 {{item.ahPick}}</text>
          <text class="m-switch" data-id="{{item.id}}" data-kind="ah" catchtap="switchAhSide">⇄</text>
        </view>
        <view class="m-cart-row" wx:if="{{item.ouPick}}">
          <checkbox class="m-check" checked="{{!!cartSel['ahOu:' + item.id]}}" data-key="ahOu:{{item.id}}" data-type="ahOu" data-id="{{item.id}}" bindtap="toggleCart" />
          <text class="m-cart-label">大小 {{item.ouPick}}</text>
          <text class="m-switch" data-id="{{item.id}}" data-kind="ahOu" catchtap="switchAhSide">⇄</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!groups.ah.length}}">等小熊补充🐾</view>
  </block>

  <!-- ============ 组串底栏 ============ -->
  <view class="cart-bar" wx:if="{{payload && !loading}}">
    <view wx:if="{{!cartMode}}" class="cart-btn" bindtap="toggleCartMode">🎯 组串{{cartCount ? ' (' + cartCount + ')' : ''}}</view>
    <block wx:else>
      <view class="cart-btn cart-btn-ghost" bindtap="toggleCartMode">✕ 退出</view>
      <view class="cart-btn" bindtap="openCart">📋 组串清单 ({{cartCount}})</view>
    </block>
  </view>

  <!-- ============ 组串抽屉 ============ -->
  <view class="cart-mask" wx:if="{{cartOpen}}" bindtap="closeCart"></view>
  <view class="cart-drawer" wx:if="{{cartOpen}}">
    <view class="cart-title">
      <text class="strong">组串清单 ({{cartCount}} 腿)</text>
      <text wx:if="{{sourceBadge}}" class="badge {{sourceBadge === 'bd' ? 'badge-gold' : sourceBadge === 'ah' ? 'badge-blue' : 'badge-red'}}">{{sourceBadge === 'bd' ? '北单来源' : sourceBadge === 'ah' ? '亚盘来源' : '竞彩来源'}}</text>
    </view>
    <scroll-view scroll-y class="cart-legs">
      <view class="cart-leg" wx:for="{{cartLegs}}" wx:key="_key">
        <text class="cart-leg-desc">{{item.desc}}</text>
        <text class="cart-leg-del" data-key="{{item._key}}" bindtap="removeLeg">✕</text>
      </view>
      <view class="empty" wx:if="{{!cartLegs.length}}">勾选场次后在此组串</view>
    </scroll-view>
    <view class="cart-sum">
      <text>注数 {{cartCalc.stakes}} 注</text>
      <text>理论奖金 ≈ {{cartCalc.expectPayout}} 元</text>
    </view>
    <view class="cart-amount">
      <text>单注</text>
      <input class="cart-input" type="digit" value="{{cartUnit}}" bindinput="onCartUnitInput" />
      <text>元 ｜ 合计 {{cartAmount}} 元(倍数 ×1)</text>
    </view>
    <button class="cart-save" bindtap="saveCart">保存登记</button>
  </view>
</view>
<!-- 投注参考图屏外画布(出图用, 不可见) -->
<canvas type="2d" id="slipCanvas" class="slip-canvas" style="width:750px;height:{{slipCanvasH}}px" />
