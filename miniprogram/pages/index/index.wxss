/* index.wxss — 推荐页样式(通用卡片/徽章/判定/空态在 app.wxss) */

/* 顶栏 */
.topbar-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.topbar-date { font-weight: 800; color: #8B5A2B; font-size: 30rpx; }
.topbar-updated { font-size: 22rpx; }
.daily-title {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #B98A5E;
  line-height: 1.6;
}

/* Tab 切换 */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 13rpx 0;
  border-radius: 999rpx;
  background: #FFF1D6;
  color: #8B5A2B;
  font-weight: 700;
  font-size: 26rpx;
}
.tab-on { background: #8B5A2B; color: #FFFFFF; }
.tab-off { opacity: 0.4; }

/* plan 块 */
.plan-card { border-top: 6rpx solid #F5A623; }
.plan-head { display: flex; justify-content: space-between; align-items: baseline; }
.plan-name { font-weight: 800; color: #8B5A2B; font-size: 26rpx; }
.plan-pct {
  font-size: 22rpx;
  color: #D97706;
  background: #FFF1D6;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  font-weight: 700;
}
.plan-text { margin-top: 8rpx; font-size: 24rpx; color: #B98A5E; line-height: 1.65; }
.plan-note-card { background: #FFF8EC; }

/* 场次卡 */
.m-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.m-teams { flex: 1; min-width: 0; }
.m-league { font-size: 22rpx; }
.m-vs {
  margin-top: 4rpx;
  font-weight: 800;
  font-size: 30rpx;
  color: #4A3A28;
}
.live-score {
  color: #D97706;
  font-weight: 800;
  font-size: 28rpx;
  flex: none;
}
.m-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  font-size: 25rpx;
}
.m-dir { font-weight: 800; color: #8B5A2B; }

/* 竞彩赔率时效(见 utils/jc.js): 角标说明这行 SP 是官方实时还是构建时快照;
   已停售场整卡压暗且不再可勾选 —— 官方下架了就不该让人往里投。 */
.odds-badge {
  margin-left: auto;
  flex: none;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.odds-live { color: #15803D; background: #ECFDF5; border: 1rpx solid #BBF7D0; }
.odds-snap { color: #B45309; background: #FFFBEB; border: 1rpx solid #FDE68A; }
.live-tag { color: #15803D; font-size: 22rpx; }
.closed-tag { color: #9A3412; font-weight: 800; font-size: 22rpx; }
/* 让球-only 场(官方没开胜平负, 见 utils/jc.js noHadOf): 点明可投的就是让球口径那一注(让球胜/让球负)。
   整行独占(m-line 是 flex-wrap 的, 不 flex:none 会被塞到上一行尾巴上) */
.nohad-tip { display: block; color: #B45309; background: #FFFBEB; border: 1rpx solid #FDE68A;
  border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 22rpx; line-height: 1.5; }
.m-swap-fix { color: #B45309; font-weight: 800; }
/* 两个盘各占一行(2026-09-15 起): 「胜负」/「让球胜负(盘口)」—— m-line 是 flex-wrap,
   不 flex:none 这两个盘的数字会挤在同一行尾巴上分不清哪个属于哪个盘 */
.mkt-row { display: block; flex: none; width: 100%; }
/* 官方只开让球没开胜平负时「胜负」那行写"无(官方未开)" */
.od-nohad { color: #B45309; font-weight: 800; }
/* 方案卡上的口径说明(见 utils/jc.js noHadNote): 与正文区分开, 但不喧宾夺主 */
.plan-nohad { margin-top: 10rpx; font-size: 22rpx; color: #B45309; background: #FFFBEB;
  border: 1rpx solid #FDE68A; border-radius: 8rpx; padding: 6rpx 12rpx; line-height: 1.5; }
.m-closed { opacity: 0.55; }
.m-closed .m-vs { text-decoration: line-through; }

/* 备注折叠 */
.m-note-toggle {
  margin-top: 12rpx;
  color: #D97706;
  font-size: 24rpx;
  font-weight: 700;
}
.m-note {
  margin-top: 10rpx;
  background: #FFF8EC;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  color: #8B5A2B;
  font-size: 23rpx;
  line-height: 1.65;
}

/* 北单 SP 三列 */
.sp3 {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}
.sp3-cell {
  flex: 1;
  text-align: center;
  background: #FFF8EC;
  border-radius: 10rpx;
  padding: 10rpx 0;
  font-weight: 800;
  color: #8B5A2B;
  font-size: 26rpx;
}
.sp3-label { font-size: 20rpx; font-weight: 400; }

/* 页面底部留白(组串底栏不挡内容) */
.page { padding-bottom: 140rpx; }

/* 比分状态色: 完场绿 / 进行中红 / 人工灰 */
.score-ft { color: #2F9E63; }
.score-live { color: #F25C5C; }
.score-manual { color: #A8A29E; font-size: 24rpx; }

/* 勾选区 */
.m-cart {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.m-check { transform: scale(1.15); }
.m-swap {
  color: #D97706;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
}

/* 组串底栏 */
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 246, 233, 0.96);
  border-top: 1rpx solid #F0E2CC;
}
.cart-btn {
  flex: 1;
  text-align: center;
  background: #8B5A2B;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.cart-btn-ghost { background: #A8A29E; }

/* 组串抽屉 */
.cart-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 60;
}
.cart-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 61;
  background: #FFFDF8;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.cart-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cart-legs { max-height: 38vh; margin-top: 12rpx; }
.cart-leg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0E2CC;
}
.cart-leg-desc { flex: 1; font-size: 24rpx; color: #4A3A28; }
.cart-leg-del {
  color: #F25C5C;
  font-weight: 800;
  padding: 0 12rpx;
  font-size: 28rpx;
}
.cart-sum {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-weight: 800;
  color: #8B5A2B;
  font-size: 26rpx;
}
.cart-amount {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #B98A5E;
}
.cart-input {
  width: 120rpx;
  background: #FFF1D6;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  text-align: center;
  color: #8B5A2B;
  font-weight: 800;
}
.cart-save {
  margin-top: 20rpx;
  background: #8B5A2B;
  color: #FFFFFF;
  font-weight: 800;
  border-radius: 999rpx;
  font-size: 30rpx;
}

/* 投注参考图屏外画布 */
.slip-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
}
